{{- /* dot == render.Message */}}
{{- pin .}}

{{- if .Bindings }}
    type {{goID $}}Bindings struct{}

    {{- range $proto := $.Bindings.Protocols}}
        func (c {{goID $}}Bindings) {{ goID $proto }}() {{goPkgUtil $proto}}MessageBindings {
        {{- with tryTmpl (print "code/proto/" $proto "/message/bindings/values") ($.ProtoMessage $proto)}}
            return {{.}}
        {{- else}}
            return {{goPkgUtil $proto}}MessageBindings{}
        {{- end}}
        }
    {{- end}}
{{- end }}

{{- if .IsPublisher}}
    type {{ . | goID }}Sender interface {
        SetPayload(payload {{.PayloadType | goUsage}}) *{{ goID . }}Out
        SetHeaders(headers {{.HeadersType | goUsage}}) *{{ goID . }}Out
        {{- with runtimeExpression .CorrelationID .PayloadType .HeadersType false}}
            SetCorrelationID(value {{goUsage .OutputType}}) *{{ goID $ }}Out
        {{- end}}
    }

    type {{ goID . }}Out struct {
        payload {{.PayloadType | goUsage}}
        headers {{.HeadersType | goUsage}}
    }

    func (m *{{ goID . }}Out) SetPayload(payload {{.PayloadType | goUsage}}) *{{ goID . }}Out {
        m.Payload = payload
        return m
    }

    func (m *{{ goID . }}Out) SetHeaders(headers {{.HeadersType | goUsage}}) *{{ goID . }}Out {
        m.Headers = headers
        return m
    }

    {{- with runtimeExpression .CorrelationID .PayloadType .HeadersType false}}
        func (m *{{ goID $ }}Out) SetCorrelationID(value {{goUsage .OutputType}}) *{{ goID $ }}Out {
            {{.InputVar}} := m.{{toString .Expression.StructFieldKind | toTitleCase}}
            {{template "code/runtimeExpression/setterBody" .}}
            m.{{toString .Expression.StructFieldKind | toTitleCase}} = {{.InputVar}}
            return m
        }
    {{- end}}

    {{- range $op := .BoundPubReplyOperations}}
        {{- $opr := $op.OperationReply}}
        {{- if and (isVisible $op) (isVisible $opr) $opr.OperationReplyAddress }}
            {{- with runtimeExpression $opr.OperationReplyAddress $.PayloadType $.HeadersType false}}
                func (m *{{ goID $ }}Out) SetReplyAddress{{$op | goID}}(value {{goUsage .OutputType}}) {
                    {{.InputVar}} := m.{{toString .Expression.StructFieldKind | toTitleCase}}
                    {{template "code/runtimeExpression/setterBody" .}}
                    m.{{toString .Expression.StructFieldKind | toTitleCase}} = {{.InputVar}}
                }
            {{- end}}
        {{- end}}
    {{- end}}
{{- end}}

{{- if .IsSubscriber }}
    type {{ $ | goID }}Receiver interface {
        Payload() {{.PayloadType | goUsage}}
        Headers() {{.HeadersType | goUsage}}
        {{- with runtimeExpression .CorrelationID $.PayloadType $.HeadersType false}}
            CorrelationID() (value {{goUsage .OutputType}}, err error)
        {{- end}}
    }

    type {{ goID $ }}In struct {
        payload {{.PayloadType | goUsage}}
        headers {{.HeadersType | goUsage}}
    }

    func (m *{{ goID . }}In) Payload() {{.PayloadType | goUsage}} {
        return m.payload
    }

    func (m *{{ goID . }}In) Headers() {{.HeadersType | goUsage}} {
        return m.headers
    }

    {{- with runtimeExpression .CorrelationID $.PayloadType $.HeadersType true}}
        func (m {{ goID $ }}In) CorrelationID() (value {{goUsage .OutputType}}, err error) {
            {{.InputVar}} := m.{{.Expression.StructFieldKind}}
            {{template "code/runtimeExpression/getterBody" .}}
            {{if .CodeSteps}}value = {{.OutputVar}}{{end}}
            return
        }
    {{- end}}

    {{- range $op := .BoundSubReplyOperations}}
        {{- $opr := $op.OperationReply}}
        {{- if and (isVisible $op) (isVisible $opr) $opr.OperationReplyAddress}}
            {{- with runtimeExpression $opr.OperationReplyAddress $.PayloadType $.HeadersType true}}
                func (m *{{ goID $ }}In) ReplyAddress{{$op | goID}}() (value {{goUsage .OutputType}}, err error) {
                    {{.InputVar}} := m.{{.Expression.StructFieldKind}}
                    {{template "code/runtimeExpression/getterBody" .}}
                    {{if .CodeSteps}}value = {{.OutputVar}}{{end}}
                    return
                }
            {{- end}}
        {{- end}}
    {{- end}}
{{- end}}
